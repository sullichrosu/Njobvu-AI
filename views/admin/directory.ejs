<%- include('../includes/header', { activePage: null, isAdmin }) %>

<style>
    .admin-hero {
        background-color: #171717;
        color: #ffffff;
        padding: 35px 25px;
        margin-bottom: 30px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .admin-hero h1 {
        font-weight: 700;
        font-size: 2.2rem;
        margin-bottom: 10px;
    }

    .admin-hero p {
        color: #94a3b8;
        font-size: 1.05rem;
        margin-bottom: 20px;
    }

    .admin-container {
        padding-top: 25px;
        padding-bottom: 50px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .admin-card {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
        background-color: #ffffff;
    }

    .admin-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .admin-card-icon {
        width: 48px;
        height: 48px;
        background: #e0f2fe;
        color: #0284c7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 5px;
    }

    .admin-card-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 10px;
    }

    .admin-card-category {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 5px;
    }

    .admin-card-body {
        font-size: 0.95rem;
        color: #334155;
        line-height: 1.6;
    }
</style>

<div id="admin-directory">
    <div class="container admin-container">
        <div class="admin-hero text-center text-md-left">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <h1><i class="fas fa-book-open mr-2"></i>Admin Dashboard</h1>
                    <p>Manage users, projects, and permissions within Njobvu</p>
                </div>
            </div>
        </div>

        <div class="row" id="adminTopicsGrid">
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card admin-card p-4">
                    <div class="admin-card-icon"><i class="fas fa-server"></i></div>
                    <div class="admin-card-title">HPC User Permissions Management</div>
                    <div class="admin-card-body">
                        <p>Manage which users can access which HPC partitions for launching jobs</p>
                        <button class="btn"><a href="/admin/partitions">Go there</a></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../includes/footer') %>
