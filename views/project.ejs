<%- include('includes/header', { activePage }) %>
<script>
	if("<%= access.includes(user)%>" == "false")
	{
		window.location.replace("/home");
	}
</script>
<div id="project">
	<div class="col-md-12">
		<h1 style="text-align: center;"><%= PName %></h1>
	</div>
	<div class="col-md-12 mb-3" style="padding-left: 15px; padding-right: 15px; margin-bottom: 15px;">
		<div class="form-row align-items-center">
			<div class="col-md-4">
				<input class="form-control" type="text" id="image-search" placeholder="Search image name..." aria-label="Search Images" value="<%= typeof search !== 'undefined' ? search : '' %>">
			</div>
			<div class="col-md-3">
				<select class="form-control" id="image-sort-by" onchange="applyImageFilters()">
					<option value="name" <%= (typeof sortBy !== 'undefined' && sortBy === 'name') ? 'selected' : '' %>>Sort by Image Name</option>
					<option value="review" <%= (typeof sortBy !== 'undefined' && sortBy === 'review') ? 'selected' : '' %>>Sort by Review Status</option>
					<option value="numLabels" <%= (typeof sortBy !== 'undefined' && sortBy === 'numLabels') ? 'selected' : '' %>>Sort by # Labels</option>
				</select>
			</div>
			<div class="col-md-2">
				<select class="form-control" id="image-sort-order" onchange="applyImageFilters()">
					<option value="asc" <%= (typeof sortOrder !== 'undefined' && sortOrder === 'asc') ? 'selected' : '' %>>Ascending</option>
					<option value="desc" <%= (typeof sortOrder !== 'undefined' && sortOrder === 'desc') ? 'selected' : '' %>>Descending</option>
				</select>
			</div>
			<div class="col-md-3 d-flex align-items-center">
				<select class="form-control" id="image-review-filter" onchange="applyImageFilters()">
					<option value="all" <%= (typeof reviewFilter !== 'undefined' && reviewFilter === 'all') ? 'selected' : '' %>>All Review Statuses</option>
					<option value="true" <%= (typeof reviewFilter !== 'undefined' && (reviewFilter === 'true' || reviewFilter === '1')) ? 'selected' : '' %>>Needs Review Only</option>
					<option value="false" <%= (typeof reviewFilter !== 'undefined' && (reviewFilter === 'false' || reviewFilter === '0')) ? 'selected' : '' %>>No Review Needed</option>
				</select>
				<button type="button" class="btn btn-secondary ml-2" id="toggle-all-review-btn" onclick="toggleAllReviewImages('<%= PName %>', '<%= Admin %>')" style="border-radius: 0; white-space: nowrap;">Toggle Review All</button>
			</div>
		</div>
	</div>
	<div class="form-group col-md-2">
		<label for="page">Page:</label>
		<input type="number" id="page" name="page" min="1" max="<%=pages%>" value="<%=Number(current)%>" style="width: 25%;">

		<label for="perpage">PerPage:</label>
		<input type="number" id="perpage" name="perpage" min="1" value="<%=perPage%>" style="width: 25%;">
		
		
	</div>
	<div class="col-md-12">
		<table class="table table-striped" style="table-layout: fixed; width: 100%;">
		<colgroup>
		<col style="width: 25%;">  <col style="width: 20%;"> <col style="width: 5%;"> <col style="width: 25%;">  <col style="width: 15%;"> </colgroup>
			<thead class="thead-dark" style="width: 100%;">
				<tr>
					<th scope="col" colspan="2">Image Name</th>
					<th scope="col" colspan="3" class="text-left">Number of Labels</th>
				</tr>
			</thead>
			<tbody>
				<% for(var i=0; i<images.length; i++) {%>
				<tr>
					<td style="overflow: hidden; text-overflow: epllipsis; white-space: nowrap;"><a href="/project/annotate?IDX=<%= IDX %>&IName=<%= encodeURIComponent(images[i].IName) %>&reviewFilter=<%= typeof reviewFilter !== 'undefined' ? reviewFilter : 'all' %>"><%= images[i].IName %></a></td>
					<!-- input checkbox for review here -->
					<td class="text-left"> 
					    <% if(images[i].reviewImage != 0) {%>
						<span style="border-radius: 0; color: red;"> Needs Review</span>
						<%}%>
					</td>
					<td class="text-right"><%= list_counter[i] %></td>
					<td class="text-right">
						<a class="btn btn-primary" href="/project/annotate?IDX=<%= IDX %>&IName=<%= encodeURIComponent(String(images[i].IName)) %>&reviewFilter=<%= typeof reviewFilter !== 'undefined' ? reviewFilter : 'all' %>" role="button" style="border-radius: 0">Annotate</a>
						<% if(images[i].reviewImage != 0) {%>
						<a class="btn btn-warning" href="/labelingV?IDX=<%= IDX %>&IName=<%= images[i].IName %>" role="button" style="border-radius: 0; margin-left: 5px;">Review</a>
						<%}%>
					</td>
					<td class="text-right"> <button type="button" class="button btn-danger" style="border-radius: 0" 
					    onclick="deleteImage('<%= String(images[i].IName) %>')" aria-label="Delete image <%= images[i].IName %>">X</button></td>
				</tr>
				
				<% } %>
			</tbody>
		</table>
	</div>
	<div class="col-md-12">
		<% if (pages > 0) { %>
		<nav aria-label="Page navigation example">
			<ul class="pagination justify-content-center">
				<% if (current == 1) { %>
				<li class="page-item disabled">
					<a class="page-link" href="#" tabindex="-1">First</a>
				</li>
				<% } else { %>
				<li class="page-item">
					<a class="page-link" href="/project?IDX=<%= IDX %>&page=1&perPage=<%= perPage %>" tabindex="-1">First</a>
				</li>
				<% } %>
				<% var i = (Number(current) > 6 ? Number(current) - 5 : 1) %>
				<% var j = i+9 %>
				<% if (i !== 1) { %>
					<li class="page-item disabled">
						<a class="page-link">...</a>
					</li>
				<% } %>
				<% for (; i <= j && i <= pages; i++) { %>
					<% if (i == current) { %>
						<li class="page-item active">
							<a class="page-link" href"#"><%= i %></a>
						</li>
					<% } else { %>
						<li class="page-item">
							<a class="page-link" href="/project?IDX=<%= IDX %>&page=<%= i %>&perPage=<%= perPage %>"><%= i %></a>
						</li>
					<% } %>
					<% if (i == j && i < pages) { %>
						<li class="page-item disabled">
							<a class="page-link" href="#">...</a>
						</li>
					<% } %>
				<% } %>
				<% if (current == pages) { %>
					<li class="page-item disabled">
						<a class="page-link" href"#">Last</a>
					</li>
				<% } else { %>
					<li class="page-item">
						<a class="page-link" href="/project?IDX=<%= IDX %>&page=<%= pages %>&perPage=<%= perPage %>">Last</a>
					</li>
				<% } %>
			</ul>
		</nav>
		<% } %>
	</div>
</div>




<script>
    function labelingPage(IDX){
        window.location.href = `/labeling?IDX=${IDX}`;
    }
</script>


<script>
	var pgnum = document.getElementById("page");
	pgnum.oninput = function(){
		console.log("pgnum oninput");
		console.log("pgnum: ", pgnum.value)
		if(pgnum.value > 0 && pgnum.value <= "<%=pages%>")
		{
			
			window.location.href = `/project?IDX=<%= IDX %>&page=${pgnum.value}&perPage=<%=perPage%>`;
		}
	}

	function deleteImage(IName){
		var result = confirm("Are you sure you want to delete this image? This action is not reversible.");
		var ImageArray = [IName];
		if (result) {
			console.log("Deleted image " + IName);
			var formData = new FormData();
			formData.append("IDX", "<%= IDX %>");
			formData.append("ImageArray", ImageArray);
			formData.append("PName", "<%= PName %>");
			formData.append("Admin", "<%= Admin %>");

			fetch('/deleteImage', {
					method: 'POST',
					body: formData 
			}).then(() => {
				window.location.reload();
			}).catch((error) => {
				console.log(error);
			});
		}
	}
</script>
<script>
	var perpage = document.getElementById("perpage");
	perpage.oninput = function(){
		if(perpage.value > 0)
		{
			window.location.href = `/project?IDX=<%= IDX %>&page=1&perPage=${perpage.value}`;
		}
	}
</script>

<script>
	function applyImageFilters() {
		var search = document.getElementById("image-search").value;
		var sortBy = document.getElementById("image-sort-by").value;
		var sortOrder = document.getElementById("image-sort-order").value;
		var reviewFilter = document.getElementById("image-review-filter").value;
		var perPage = document.getElementById("perpage").value || 10;
		window.location.href = `/project?IDX=<%= IDX %>&page=1&perPage=${perPage}&search=${encodeURIComponent(search)}&sortBy=${sortBy}&sortOrder=${sortOrder}&reviewFilter=${reviewFilter}`;
	}

	var imgSearchInput = document.getElementById("image-search");
	if (imgSearchInput) {
		imgSearchInput.addEventListener("keypress", function(e) {
			if (e.key === "Enter") {
				applyImageFilters();
			}
		});
	}

	async function toggleAllReviewImages(PName, Admin) {
		if (!confirm("Are you sure you want to toggle the review state for all images in this project?")) {
			return;
		}
		try {
			var formData = new FormData();
			formData.append("PName", PName);
			formData.append("Admin", Admin);
			var resp = await fetch('/toggleAllReview', {
				method: 'POST',
				body: formData
			});
			var data = await resp.json();
			if (data.Success === "Yes") {
				window.location.reload();
			} else {
				alert("Error toggling review state: " + (data.error || "Unknown error"));
			}
		} catch (err) {
			console.error("Failed to toggle all review state:", err);
			alert("An error occurred while toggling review state.");
		}
	}
</script>

<%- include('includes/footer') %>

