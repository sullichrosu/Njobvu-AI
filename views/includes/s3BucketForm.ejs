<div class="card mb-4 mt-3" id="s3BucketSection">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">S3 Bucket Configuration (Inference)</h5>
        <button class="btn btn-sm btn-outline-light" type="button" data-toggle="collapse" data-target="#s3BucketFormCollapse" aria-expanded="false" aria-controls="s3BucketFormCollapse">
            Attach / Configure S3 Bucket
        </button>
    </div>
    <div class="collapse" id="s3BucketFormCollapse">
        <div class="card-body">
            <p class="text-muted">
                Attach an S3 bucket to stream or sync images for inference. You can configure a maximum image limit to restrict the number of pulled images.
            </p>
            <div id="s3BucketCurrentStatus" class="alert alert-info d-none mb-3"></div>
            <form id="s3BucketForm" onsubmit="return false;">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="s3_bucket_name">Bucket Name <span class="text-danger">*</span></label>
                        <input id="s3_bucket_name" class="form-control" type="text" placeholder="my-image-bucket" required>
                    </div>
                    <div class="form-group col-md-6">
                        <label for="s3_region">Region <span class="text-danger">*</span></label>
                        <input id="s3_region" class="form-control" type="text" placeholder="us-east-1" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="s3_prefix">Prefix (Optional)</label>
                        <input id="s3_prefix" class="form-control" type="text" placeholder="images/">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="s3_endpoint">S3 Endpoint (Optional)</label>
                        <input id="s3_endpoint" type="text" class="form-control" placeholder="https://s3.amazonaws.com">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="s3_max_images">Max Image Limit (Optional)</label>
                        <input id="s3_max_images" name="max_images" type="number" min="1" class="form-control" placeholder="Unlimited (e.g. 100)">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="s3_access_key_id">Access Key ID</label>
                        <input id="s3_access_key_id" class="form-control" type="text" autocomplete="off">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="s3_secret_access_key">Secret Access Key</label>
                        <input id="s3_secret_access_key" class="form-control" type="password" autocomplete="off">
                    </div>
                </div>
                <div>
                    <label class="mb-2 text-info" id="s3progress" aria-live="polite" aria-atomic="true"></label>
                </div>
                <button class="btn btn-primary" id="s3SubmitBtn" type="button" onclick="attachAndSyncS3Bucket()">Attach &amp; Sync Bucket</button>
                <button class="btn btn-danger d-none ml-2" id="s3DetachBtn" type="button" onclick="detachS3Bucket()">Detach Bucket</button>
            </form>
        </div>
    </div>
</div>

<script>
    async function loadS3BucketStatus() {
        try {
            const res = await fetch(`/api/v2/projects/<%= Admin %>/<%= PName %>/s3-bucket`);
            if (res.ok) {
                const data = await res.json();
                if (data.success && data.bucket) {
                    const b = data.bucket;
                    const statusEl = document.getElementById('s3BucketCurrentStatus');
                    if (statusEl) {
                        statusEl.classList.remove('d-none');
                        let limitText = b.MaxImages ? ` (Max Images: ${b.MaxImages})` : ' (Unlimited images)';
                        statusEl.innerHTML = `<strong>Attached S3 Bucket:</strong> <code>${b.BucketName}</code> [Region: <code>${b.Region}</code>]${limitText}`;
                    }
                    if (document.getElementById('s3_bucket_name')) document.getElementById('s3_bucket_name').value = b.BucketName || '';
                    if (document.getElementById('s3_region')) document.getElementById('s3_region').value = b.Region || '';
                    if (document.getElementById('s3_prefix')) document.getElementById('s3_prefix').value = b.Prefix || '';
                    if (document.getElementById('s3_endpoint')) document.getElementById('s3_endpoint').value = b.Endpoint || '';
                    if (b.MaxImages && document.getElementById('s3_max_images')) {
                        document.getElementById('s3_max_images').value = b.MaxImages;
                    }
                    const detachBtn = document.getElementById('s3DetachBtn');
                    if (detachBtn) detachBtn.classList.remove('d-none');
                }
            }
        } catch (e) {
            console.log('No S3 bucket attached or error loading bucket status', e);
        }
    }

    async function attachAndSyncS3Bucket() {
        const bucketName = document.getElementById('s3_bucket_name').value;
        const region = document.getElementById('s3_region').value;
        const prefix = document.getElementById('s3_prefix').value;
        const accessKeyId = document.getElementById('s3_access_key_id').value;
        const secretAccessKey = document.getElementById('s3_secret_access_key').value;
        const endpoint = document.getElementById("s3_endpoint").value;
        const maxImages = document.getElementById("s3_max_images").value;

        if (!bucketName || !region) {
            alert("Bucket Name and Region are required.");
            return;
        }

        const submitBtn = document.getElementById('s3SubmitBtn');
        const progress = document.getElementById('s3progress');
        submitBtn.disabled = true;

        try {
            progress.textContent = "Attaching S3 bucket...";

            const attachRes = await fetch(`/api/v2/projects/<%= Admin %>/<%= PName %>/s3-bucket`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    BucketName: bucketName,
                    Region: region,
                    Prefix: prefix,
                    AccessKeyId: accessKeyId,
                    SecretAccessKey: secretAccessKey,
                    Endpoint: endpoint,
                }),
            });

            const attachBody = await attachRes.json();
            if (!attachRes.ok || !attachBody.success) {
                throw new Error(attachBody.error || "Could not attach S3 bucket");
            }

            progress.textContent = "Syncing images from S3...";

            const syncRes = await fetch(`/api/v2/projects/<%= Admin %>/<%= PName %>/s3-bucket/sync`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    maxImages: maxImages ? parseInt(maxImages, 10) : null,
                }),
            });

            const syncBody = await syncRes.json();
            if (!syncRes.ok || !syncBody.success) {
                throw new Error(syncBody.error || "Could not sync images from S3 bucket");
            }

            progress.textContent = "";
            alert(`Synced ${syncBody.syncedCount} new image(s) from S3 (skipped ${syncBody.skippedCount} already present).`);
            window.location.reload();
        } catch (err) {
            progress.textContent = "";
            submitBtn.disabled = false;
            alert("Something went wrong attaching/syncing the S3 bucket.\nReason: " + err.message);
        }
    }

    async function detachS3Bucket() {
        if (!confirm("Are you sure you want to detach the S3 bucket?")) return;
        try {
            const res = await fetch(`/api/v2/projects/<%= Admin %>/<%= PName %>/s3-bucket`, {
                method: 'DELETE',
            });
            const data = await res.json();
            if (res.ok && data.success) {
                alert("S3 Bucket detached.");
                window.location.reload();
            } else {
                alert("Failed to detach S3 bucket: " + (data.error || res.statusText));
            }
        } catch (err) {
            alert("Error detaching S3 bucket: " + err.message);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        loadS3BucketStatus();
    });
</script>
